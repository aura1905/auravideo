 "subs": [
  {
   "text": "Nobody quit this Steam\ndemo in under ten minutes.\nNot one reviewer.",
   "start": 0.0,
   "duration": 4.356,
   "fontSize": 50,
   "y": 330,
   "bgOpacity": 0.62
  },
  {
   "text": "The median player had\neleven hours in before\nthey wrote anything.",
   "start": 4.606,
   "duration": 3.468,
   "fontSize": 50,
   "y": 330,
   "bgOpacity": 0.62
  },
  {
   "text": "So I opened the build.\nIt's Unity, and I L two C\nP P usually hides what a\nteam used.",
   "start": 8.324,
   "duration": 5.923,
   "fontSize": 42,
   "y": 330,
   "bgOpacity": 0.62
  },
  {
   "text": "Except twenty four\nassembly names leak out in\na data file. Here's what\nthey installed.",
   "start": 14.497,
   "duration": 5.218,
   "fontSize": 42,
   "y": 330,
   "bgOpacity": 0.62
  },
  {
   "text": "Sentry for crash reports.\nS Q Lite for three hundred\nrelics. Zero-allocation\nLINQ.",
   "start": 19.965,
   "duration": 6.393,
   "fontSize": 42,
   "y": 330,
   "bgOpacity": 0.62
  },
  {
   "text": "That's not a first\nproject's list. That's\nwhat you install after\nsomething went wrong last\ntime.",
   "start": 26.608,
   "duration": 5.27,
   "fontSize": 42,
   "y": 330,
   "bgOpacity": 0.62
  }
 ],
