  "minimum": "<strong>最低配置:</strong><br><ul class=\"bb_ul\"><li><strong>操作系统:</strong> Windows 10<br></li><li><strong>处理器:</strong> Intel i5-4460 / AMD Ryzen 3 1200<br></li><li><strong>内存:</strong> 8 GB RAM<br></li><li><strong>显卡:</strong> GTX 960 / RX 470<br></li><li><strong>存储空间:</strong> 需要 15 GB 可用空间<br></li><li><strong>附注事项:</strong> For 'Low' graphics preset on Full HD. HDD okay, no SSD required</li></ul>",
  "recommended": "<strong>推荐配置:</strong><br><ul class=\"bb_ul\"><li><strong>操作系统:</strong> Windows 10 or 11<br></li><li><strong>处理器:</strong> Intel i5-8600K / AMD Ryzen 5 2600<br></li><li><strong>内存:</strong> 16 GB RAM<br></li><li><strong>显卡:</strong> GTX 1660 Ti / RTX 2060 / RX 5700<br></li><li><strong>DirectX 版本:</strong> 11<br></li><li><strong>存储空间:</strong> 需要 15 GB 可用空间<br></li><li><strong>附注事项:</strong> SSD recommended</li></ul>"
 },
 "mac_requirements": {
