  "recommended": "<strong>推荐配置:</strong><br><ul class=\"bb_ul\"><li><strong>操作系统:</strong> MacOS 13 Sequoia or newer<br></li><li><strong>处理器:</strong> Apple M1 Pro<br></li><li><strong>内存:</strong> 16 GB RAM<br></li><li><strong>存储空间:</strong> 需要 18 GB 可用空间</li></ul>"
 },
