 "pc_requirements": {
  "minimum": "<strong>최소:</strong><br><ul class=\"bb_ul\"><li><strong>운영 체제:</strong> Windows 10<br></li><li><strong>프로세서:</strong> Intel i5-4460 / AMD Ryzen 3 1200<br></li><li><strong>메모리:</strong> 8 GB RAM<br></li><li><strong>그래픽:</strong> GTX 960 / RX 470<br></li><li><strong>저장 공간:</strong> 15 GB 사용 가능 공간<br></li><li><strong>추가 사항:</strong> For 'Low' graphics preset on Full HD. HDD okay, no SSD required</li></ul>",
  "recommended": "<strong>권장:</strong><br><ul class=\"bb_ul\"><li><strong>운영 체제:</strong> Windows 10 or 11<br></li><li><strong>프로세서:</strong> Intel i5-8600K / AMD Ryzen 5 2600<br></li><li><strong>메모리:</strong> 16 GB RAM<br></li><li><strong>그래픽:</strong> GTX 1660 Ti / RTX 2060 / RX 5700<br></li><li><strong>DirectX:</strong> 버전 11<br></li><li><strong>저장 공간:</strong> 15 GB 사용 가능 공간<br></li><li><strong>추가 사항:</strong> SSD recommended</li></ul>"
 },
 "mac_requirements": {
  "minimum": "<strong>최소:</strong><br><ul class=\"bb_ul\"><li><strong>운영 체제:</strong> MacOS 13 Ventura or newer<br></li><li><strong>프로세서:</strong> Apple M1<br></li><li><strong>메모리:</strong> 16 GB RAM<br></li><li><strong>저장 공간:</strong> 18 GB 사용 가능 공간<br></li><li><strong>추가 사항:</strong>  For 'Low' graphics preset on Full HD.</li></ul>",
  "recommended": "<strong>권장:</strong><br><ul class=\"bb_ul\"><li><strong>운영 체제:</strong> MacOS 13 Sequoia or newer<br></li><li><strong>프로세서:</strong> Apple M1 Pro<br></li><li><strong>메모리:</strong> 16 GB RAM<br></li><li><strong>저장 공간:</strong> 18 GB 사용 가능 공간</li></ul>"
 },
