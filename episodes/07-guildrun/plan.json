  },
  {
   "text": "1.17 GB download",
   "start": 17.789,
   "duration": 17.148,
   "x": 560,
   "y": -230,
   "fontSize": 40,
   "bgColor": "#0b1a3a",
   "bgOpacity": 0.85,
   "bgPadding": 18,
