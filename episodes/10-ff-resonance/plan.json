  {
   "text": "467 MB executable",
   "start": 17.084,
   "duration": 17.356,
   "x": 560,
   "y": -230,
   "fontSize": 40,
   "bgColor": "#0b1a3a",
   "bgOpacity": 0.85,
   "bgPadding": 18,
   "outline": 0,
