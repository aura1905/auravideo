[{"recommendationid": "234333716", "author": {"steamid": "76561198292266764", "personaname": "Braulio ZT", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198292266764/", "num_games_owned": 0, "num_reviews": 69, "playtime_forever": 70, "playtime_last_two_weeks": 70, "playtime_at_review": 70, "last_played": 1788385578, "avatar": "4ca775617833e8f4800be2bf8a5e093551ad38ad"}, "language": "english", "review": "Loved it!", "timestamp_created": 1788386042, "timestamp_updated": 1788386042, "voted_up": true, "votes_up": 1, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1788192015", "reactions": []}, {"recommendationid": "234304120", "author": {"steamid": "76561198354591727", "personaname": "Error 404", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/butnobodycloe/", "num_games_owned": 0, "num_reviews": 33, "playtime_forever": 57, "playtime_last_two_weeks": 57, "playtime_at_review": 57, "last_played": 1788356205, "avatar": "f55dd8f48b114474259254d45b2ed71734f1c4ca"}, "language": "french", "review": "Petite démo sympathique ! On remarque effectivement l'inspiration aux jeux Persona, \nEt même si le jeu est indé et que les graphismes peuvent rebuter, on rentre facilement dans l'histoire, et j'ai passé un bon moment sur la démo! Hâte de voir le jeu final !\n\nDommage pas de traductions Française, mais l'anglais du jeu reste accessible", "timestamp_created": 1788356320, "timestamp_updated": 1788356320, "voted_up": true, "votes_up": 1, "votes_funny": 0, "weighted_vote_score": 0.5, "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1788192015", "reactions": []}, {"recommendationid": "234271450", "author": {"steamid": "76561198954506627", "personaname": "BLVDES", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198954506627/", "num_games_owned": 0, "num_reviews": 2, "playtime_forever": 434, "playtime_last_two_weeks": 434, "playtime_at_review": 434, "last_played": 1788302570, "avatar": "3ff6164499cca0e26d88d80b457d05cdca6f630b"}, "language": "english", "review": "I played the demo to completion and I’m definitely buying this game. It’s a well thought out love letter to the Persona franchise. I even caught a couple of references and nods to P4 as I played through. Stoked for the final product!", "timestamp_created": 1788307465, "timestamp_updated": 1788307465, "voted_up": true, "votes_up": 3, "votes_funny": 0, "weighted_vote_score": "0.534209191799163818", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1788192015", "reactions": []}, {"recommendationid": "234247771", "author": {"steamid": "76561198045781003", "personaname": "floosim", "persona_status": "offline", "profile_url": "https://steamcommunity.com/profiles/76561198045781003/", "num_games_owned": 0, "num_reviews": 7, "playtime_forever": 70, "playtime_last_two_weeks": 70, "playtime_at_review": 70, "last_played": 1788282747, "avatar": "8d86250f45fa45ff374134fbe7e3ac2e01e0f899"}, "language": "english", "review": "Very good! You can tell the developer loves the Persona series and has taken heavy inspiration from it. I really enjoyed the setting and voice acting.\nI think combat in the demo could have been expanded more. So far I only fought one basic enemy and one semi-boss. I didn't fully understand the combat system (types, ranged/melee).\n\nStill, you can feel the love for the genre that went into this and I am looking forward to the full release!", "timestamp_created": 1788283048, "timestamp_updated": 1788283048, "voted_up": true, "votes_up": 2, "votes_funny": 0, "weighted_vote_score": "0.505882382392883301", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1788192015", "reactions": []}, {"recommendationid": "234180235", "author": {"steamid": "76561198799205370", "personaname": "Dough", "persona_status": "online", "profile_url": "https://steamcommunity.com/profiles/76561198799205370/", "num_games_owned": 172, "num_reviews": 11, "playtime_forever": 125, "playtime_last_two_weeks": 125, "playtime_at_review": 125, "last_played": 1788200359, "avatar": "b856a4cb6ad65ea3a152df8ea28b51e9352c4c2c"}, "language": "english", "review": "Great Demo, setting up a cool story. Will buy full game when it releases", "timestamp_created": 1788200598, "timestamp_updated": 1788200598, "voted_up": true, "votes_up": 2, "votes_funny": 0, "weighted_vote_score": "0.523809552192687988", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1788192015", "reactions": []}, {"recommendationid": "234179435", "author": {"steamid": "76561198025764277", "personaname": "V", "persona_status": "offline", "profile_url": "https://steamcommunity.com/id/graceless_vi/", "num_games_owned": 351, "num_reviews": 55, "playtime_forever": 41, "playtime_last_two_weeks": 41, "playtime_at_review": 23, "last_played": 1788201026, "avatar": "aa41b66a005534fd4cf54bae06e970b80f94fba3"}, "language": "english", "review": "Little bit unsure what to make of this one, I do adore the chunky console-style visuals, the music is really good, there's even proper voice acting, but you have to wonder what possessed a solo developer from Austria to devote several years of his life to creating... another [i]Persona[/i]? Can't wait to find out in the full version! I hope it will turn out to be more than a fan game / pastiche.", "timestamp_created": 1788199872, "timestamp_updated": 1788200103, "voted_up": true, "votes_up": 1, "votes_funny": 1, "weighted_vote_score": "0.538676619529724121", "comment_count": 0, "steam_purchase": true, "received_for_free": false, "refunded": false, "written_during_early_access": false, "primarily_steam_deck": false, "app_release_date": "1788192015", "reactions": []}]