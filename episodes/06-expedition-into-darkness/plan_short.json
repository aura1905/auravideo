 "subs": [
  {
   "text": "This Steam demo is sixteen\npoint nine gigabytes.\nThree people made it.",
   "start": 0.0,
   "duration": 4.852,
   "fontSize": 50,
   "y": 330,
   "bgOpacity": 0.62
  },
  {
   "text": "Seven hundred and seventy\nmegabytes of that download\nis a file they forgot to\ndelete.",
   "start": 5.102,
   "duration": 4.669,
   "fontSize": 42,
   "y": 330,
   "bgOpacity": 0.62
  },
  {
   "text": "Debug symbols. They're how\nyou read a crash report.\nThey belong on a build\nserver, not on your\nplayers' drives.",
   "start": 10.021,
   "duration": 6.863,
   "fontSize": 42,
   "y": 330,
   "bgOpacity": 0.62
  },
  {
   "text": "The rest is real content,\nto be fair. One scene, and\nfifteen hundred streaming\nbundles behind it.",
   "start": 17.134,
   "duration": 6.054,
   "fontSize": 42,
   "y": 330,
   "bgOpacity": 0.62
  },
  {
   "text": "Every weapon is separate\nparts with their own\nstats, so the art\nmultiplies fast.",
   "start": 23.438,
   "duration": 4.852,
   "fontSize": 42,
   "y": 330,
   "bgOpacity": 0.62
  },
  {
   "text": "Though a single two\ngigabyte bundle usually\nmeans textures nobody set\nthe compression on.",
   "start": 28.54,
   "duration": 5.009,
   "fontSize": 42,
   "y": 330,
   "bgOpacity": 0.62
  }
 ],
