 "subs": [
  {
   "text": "Unity names one folder 'Do\nNot Ship It With Your\nGame.' This demo shipped\nit.",
   "start": 0.9,
   "duration": 4.904,
   "fontSize": 42,
   "y": 330,
   "bgOpacity": 0.62
  },
  {
   "text": "It is 1.6 of the 2.2\ngigabytes you download.",
   "start": 6.054,
   "duration": 3.468,
   "fontSize": 50,
   "y": 330,
   "bgOpacity": 0.62
  },
  {
   "text": "Frontier Tale is a cozy\nfarming game with\nextraction runs. 219\npeople are in the demo\nnow.",
   "start": 9.772,
   "duration": 6.811,
   "fontSize": 42,
   "y": 330,
   "bgOpacity": 0.62
  },
  {
   "text": "The game itself is 615\nmegabytes. The rest is\nthat folder.",
   "start": 16.833,
   "duration": 4.434,
   "fontSize": 50,
   "y": 330,
   "bgOpacity": 0.62
  },
  {
   "text": "Inside: 577 C++ files,\ntheir whole game\ntranslated out of C#.",
   "start": 21.517,
   "duration": 6.681,
   "fontSize": 50,
   "y": 330,
   "bgOpacity": 0.62
  },
  {
   "text": "And 88 debug symbol files.\nOne is 688 megabytes by\nitself.",
   "start": 28.448,
   "duration": 5.74,
   "fontSize": 50,
   "y": 330,
   "bgOpacity": 0.62
  },
  {
   "text": "IL2CPP hides what a team\nused. This build lists it:\nA* Pathfinding, FMOD,\nCinemachine.",
   "start": 34.438,
   "duration": 8.352,
   "fontSize": 42,
   "y": 330,
   "bgOpacity": 0.62
  }
 ],
